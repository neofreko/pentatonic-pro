{
  "name": "pentatonic-pro-guitar-scale-master",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "start": "bun dev",
    "setup": "bun install",
    "restart": "bun run clean && bun install && bun run dev:force",
    "clean": "rm -rf dist .vite",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "@google/genai": "^1.37.0",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.3.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}